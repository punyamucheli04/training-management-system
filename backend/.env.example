# Copy this file to "backend/.env" and put your MySQL details in it.
# Spring Boot reads it automatically (see spring.config.import in
# src/main/resources/application.properties). Values here take priority
# over the defaults written in application.properties.
#
# Do not wrap values in quotes.

DB_URL=jdbc:mysql://localhost:3306/training_management_system?useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=YOUR_PASSWORD
